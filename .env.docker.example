# Settings for docker-compose.yml. Copy to .env and fill in.

# The port fx0 listens on, on this machine.
# FX0_PORT=3210

# The address you open fx0 at, http://localhost:<FX0_PORT> by default. Set it when you
# reach the app by another host name: requests from any other origin are refused.
# APP_URL=http://localhost:3210

# Required: a random string of at least 32 characters.
# Example generator: openssl rand -base64 32
SESSION_SECRET=

# Required: your OpenAI-compatible provider. Requests go to
# <FX0_PROVIDER_BASE_URL>/chat/completions, so include the /v1 when the server has one.
# A server on this machine is http://host.docker.internal:<port>/v1, not localhost.
FX0_PROVIDER_BASE_URL=
# Leave empty for a server that needs no key.
FX0_PROVIDER_API_KEY=
# Required: the model new chats start on. It must support tool calls.
FX0_MODEL=

# Optional: the models the picker offers, comma separated. Without it fx0 lists the
# server's own <FX0_PROVIDER_BASE_URL>/models.
# FX0_PROVIDER_MODELS=model-a,model-b
# Optional: what fx0 can't ask the server. They apply to every model.
# FX0_PROVIDER_CONTEXT_WINDOW=128000
# FX0_PROVIDER_MAX_OUTPUT_TOKENS=16000
# Set to 1 when the models accept images: attachments and design screenshots.
# FX0_PROVIDER_VISION=1
# Optional: sent as reasoning_effort with every request (low, medium, high, or
# whatever your provider accepts). Without it the provider's default applies.
# FX0_PROVIDER_REASONING_EFFORT=low

# Optional: the name shown on your messages.
# FX0_LOCAL_USER_NAME=You
